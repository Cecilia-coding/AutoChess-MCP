# Local autochess server. Runtime state is created under .local/ and is ignored by Git.
CHESS_ROOM_PORT=8791
# Browser-visible scheme, host and port. Leave empty for local room-only use.
# Public one-port and Docker deployments must set this explicitly at startup.
CHESS_PUBLIC_ORIGIN=
CHESS_ACCOUNT_DATA=.local/accounts
CHESS_ROOM_DATA=.local/chess-rooms
CHESS_DISABLE_CURSOR=1
CHESS_WHEEL_PREVIEW=1
CHESS_HOOK_MCP_URL=http://127.0.0.1:8791/mcp

# Optional trusted satellite adapter (for example CEDAR TOY). Leave empty to disable.
# Generate a private value and configure the same value in the platform adapter.
CHESS_PLATFORM_SECRET=

# Optional one-port gateway settings (`npm run cloud`).
CHESS_WEB_PORT=8787
CHESS_GATEWAY_PORT=8792
CHESS_GATEWAY_HOST=127.0.0.1

# Content selection. The AI pack is the default; jianghu is also available.
CHESS_PACK=ai
CHESS_RP=0
